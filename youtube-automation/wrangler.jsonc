{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ar-project-youtube-automation",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true
  },
  "secrets": {
    "required": [
      "OPENAI_API_KEY",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "TOKEN_ENCRYPTION_KEY",
      "ADMIN_TOKEN"
    ]
  },
  "vars": {
    "CONTENT_NICHE": "technology",
    "OPENAI_MODEL": "gpt-5.6-luna",
    "VIDEO_MODEL": "black-forest-labs/flux-3-video",
    "VIDEO_DURATION_SECONDS": "15",
    "AUTO_PUBLISH": "false",
    "YOUTUBE_CATEGORY_ID": "28",
    "TIMEZONE": "Africa/Tunis"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ar-project-youtube",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "ar-project-youtube-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "media": {
    "binding": "MEDIA"
  },
  "workflows": [
    {
      "name": "ar-project-youtube-pipeline",
      "binding": "YOUTUBE_PIPELINE",
      "class_name": "YouTubeAutomationWorkflow",
      "schedules": ["0 17 * * *"]
    }
  ]
}
